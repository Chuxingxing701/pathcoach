{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "case.schema.json",
  "title": "CaseMeta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "split",
    "site",
    "siteLabel",
    "clinical",
    "stain",
    "specimen",
    "templateId",
    "tiles",
    "regions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "split": {
      "enum": ["practice", "pretest", "posttest", "trial"]
    },
    "site": {
      "type": "string"
    },
    "siteLabel": {
      "$ref": "i18n.schema.json"
    },
    "clinical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["age", "sex", "smoking", "packYears"],
      "properties": {
        "age": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 120
        },
        "sex": {
          "enum": ["male", "female", null]
        },
        "smoking": {
          "type": ["string", "null"]
        },
        "packYears": {
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },
    "stain": {
      "const": "HE"
    },
    "specimen": {
      "enum": ["FFPE", "frozen"]
    },
    "templateId": {
      "type": "string"
    },
    "tiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dzi", "mpp", "width", "height", "scanMag"],
      "properties": {
        "dzi": {
          "type": "string",
          "format": "uri-reference"
        },
        "mpp": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "scanMag": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "regions": {
      "type": ["string", "null"]
    }
  }
}
