{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "manifest.schema.json",
  "title": "Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases", "trial"],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "trial": {
      "type": "string",
      "description": "ID of the non-study viewer trial case"
    }
  }
}
