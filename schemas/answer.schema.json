{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "answer.schema.json",
  "title": "CaseAnswer",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "truth", "primaryDiagnosis"],
